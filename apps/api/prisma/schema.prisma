generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id                  Int                @id @default(autoincrement())
  discordId           String             @unique @db.VarChar(30)
  username            String             @db.VarChar(100)
  avatar              String?            @db.Text
  bullyPoints         Int                @default(0)
  role                UserRole           @default(MEMBER)
  active              Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  purchases           Purchase[]

  pointTransactions   PointTransaction[] @relation("TransactionUser")
  createdTransactions PointTransaction[] @relation("TransactionAdmin")

  sentTransfers       BankTransfer[]     @relation("SentTransfers")
  receivedTransfers   BankTransfer[]     @relation("ReceivedTransfers")

  jobShifts JobShift[]

  socialProfile  SocialProfile?

sentLikes      SocialLike[]  @relation("SocialLikeSender")
receivedLikes  SocialLike[]  @relation("SocialLikeReceiver")

matchesAsOne   SocialMatch[] @relation("SocialMatchUserOne")
matchesAsTwo   SocialMatch[] @relation("SocialMatchUserTwo")
}

model Product {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(120)
  description String     @db.Text
  imageUrl    String?    @db.Text
  price       Int
  stock       Int?
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  purchases   Purchase[]
}

model Purchase {
  id        Int            @id @default(autoincrement())
  userId    Int
  productId Int
  price     Int
  status    PurchaseStatus @default(COMPLETED)
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id])
  product   Product        @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
}

model PointTransaction {
  id        Int             @id @default(autoincrement())
  userId    Int
  amount    Int
  type      TransactionType
  reason    String          @db.VarChar(255)
  createdBy Int?
  createdAt DateTime        @default(now())
  user      User            @relation("TransactionUser", fields: [userId], references: [id])
  admin     User?           @relation("TransactionAdmin", fields: [createdBy], references: [id])

  @@index([userId])
  @@index([createdBy])
}

model BankTransfer {
  id          Int      @id @default(autoincrement())
  senderId    Int
  recipientId Int
  amount      Int
  description String?  @db.VarChar(140)
  createdAt   DateTime @default(now())

  sender      User     @relation("SentTransfers", fields: [senderId], references: [id])
  recipient   User     @relation("ReceivedTransfers", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

model JobShift {
  id          Int       @id @default(autoincrement())
  userId      Int
  reward      Int       @default(50)
  startedAt   DateTime  @default(now())
  availableAt DateTime
  completedAt DateTime?

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([startedAt])
  @@index([completedAt])
}

model SocialProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  bio       String?  @db.VarChar(300)
  interests String?  @db.VarChar(300)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@index([active])
}

model SocialLike {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  createdAt  DateTime @default(now())

  sender     User     @relation("SocialLikeSender", fields: [senderId], references: [id])
  receiver   User     @relation("SocialLikeReceiver", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

model SocialMatch {
  id        Int      @id @default(autoincrement())
  userOneId Int
  userTwoId Int
  createdAt DateTime @default(now())

  userOne   User     @relation("SocialMatchUserOne", fields: [userOneId], references: [id])
  userTwo   User     @relation("SocialMatchUserTwo", fields: [userTwoId], references: [id])

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@index([createdAt])
}